# WillSpot backend configuration. Copy to .env, or run `npm run env:init` to generate
# real local secrets. Never commit .env. In production, inject these from a secret manager.

NODE_ENV=development
LOG_LEVEL=info

# --- Signing keys (Ed25519 PEM, newlines escaped as \n). Identity signs; others only verify. ---
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"

# --- Service-to-service tokens (one per calling service, 32+ random bytes) ---
SERVICE_TOKEN_IDENTITY=REPLACE_ME
SERVICE_TOKEN_WALLET=REPLACE_ME
SERVICE_TOKEN_TRADE=REPLACE_ME
SERVICE_TOKEN_GIFTCARDS=REPLACE_ME
SERVICE_TOKEN_BILLS=REPLACE_ME
SERVICE_TOKEN_RISK=REPLACE_ME

# --- Field encryption keys (32 random bytes, base64) ---
# Gift-card codes (giftcards service) and TOTP secrets (identity service).
GIFTCARD_CODE_KEY=REPLACE_ME
IDENTITY_FIELD_KEY=REPLACE_ME

# --- Databases: one per service ---
IDENTITY_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_identity
WALLET_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_wallet
TRADE_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_trade
CONFIG_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_config
GIFTCARDS_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_giftcards
BILLS_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_bills
RISK_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_risk
NOTIFICATIONS_DATABASE_URL=postgres://postgres@127.0.0.1:55433/willspot_notifications

# --- Internal service URLs ---
IDENTITY_INTERNAL_URL=http://localhost:4001
WALLET_INTERNAL_URL=http://localhost:4002
TRADE_INTERNAL_URL=http://localhost:4003
CONFIG_INTERNAL_URL=http://localhost:4004
GIFTCARDS_INTERNAL_URL=http://localhost:4005
BILLS_INTERNAL_URL=http://localhost:4006
RISK_INTERNAL_URL=http://localhost:4007
NOTIFICATIONS_INTERNAL_URL=http://localhost:4008

# --- Gateway ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_GENERAL=300
RATE_LIMIT_STRICT=20
# Shared rate-limit store across gateway replicas (optional locally, required with >1 replica)
REDIS_URL=

# --- Providers (sandbox only in the MVP; real ones need licences/partners) ---
OTP_MODE=sandbox
# 1 = return the OTP in API responses so you can test without SMS. Refused when NODE_ENV=production.
EXPOSE_DEV_OTP=1
BANK_PROVIDER=sandbox
DEPOSIT_WEBHOOK_SECRET=REPLACE_ME

# --- Ops alerts (optional): Slack/Teams/Google Chat incoming-webhook URL ---
OPS_ALERT_WEBHOOK_URL=
# NGN per USD used only to size USD deposits for AML screening
RISK_USD_NGN=1500

# --- Real providers (phase 3). Leave unset to stay on sandbox. See docs/PROVIDERS.md ---
# BANK_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PREFERRED_BANK=
# KYC_PROVIDER=dojah
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io
# OTP_MODE=termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
# BILL_PROVIDER=vtpass
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com

# --- Events and push (phase 4) ---
# NATS JetStream for domain events. Empty = events wait in each service's outbox.
# scripts/dev.ts starts a local nats-server automatically if it's installed.
NATS_URL=
NATS_TOKEN=
# sandbox (records only) or fcm. FCM needs a Firebase service-account JSON (or FCM_SERVICE_ACCOUNT_JSON_FILE).
PUSH_PROVIDER=sandbox
FCM_SERVICE_ACCOUNT_JSON=
# Name used in notification text (defaults to WillSpot)
BRAND_NAME=

# --- Observability (phase 4) ---
# OpenTelemetry collector base URL, e.g. http://otel-collector:4318 (spans go to /v1/traces). Empty = no export.
OTEL_EXPORTER_OTLP_ENDPOINT=
DEPLOY_ENV=development
# Prometheus scrape port per process (0 disables). dev.ts gives each service its own.
METRICS_PORT=9464
# Seconds-to-drain after SIGTERM before closing (lets the load balancer stop routing)
SHUTDOWN_DRAIN_MS=5000
# 0 = don't migrate on start (production: a deploy Job runs MIGRATE_ONLY=1 with the schema-owner role)
MIGRATE_ON_START=1
# Any VAR can instead be given as VAR_FILE=/path/to/secret (secret-manager volume mounts).

# --- First admin (created on first start if missing) ---
ADMIN_EMAIL=admin@willspot.local
ADMIN_PASSWORD=REPLACE_ME
# 1 = admin tools need a two-factor (TOTP) session. Must be 1 in production.
ADMIN_REQUIRE_MFA=0
